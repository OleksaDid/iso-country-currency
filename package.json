{
  "name": "iso-country-currency",
  "version": "1.0.0-beta.0",
  "description": "ISO 3166 countries with ISO 4217 currency, symbol, numeric code, minor units and locale-aware formatting",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OleksaDid/iso-country-currency.git"
  },
  "homepage": "https://github.com/OleksaDid/iso-country-currency#readme",
  "bugs": "https://github.com/OleksaDid/iso-country-currency/issues",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/OleksaDid"
    },
    {
      "type": "thanks.dev",
      "url": "https://thanks.dev/u/gh/oleksadid"
    }
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "npm run build && node --test",
    "check-data": "npm run build && node scripts/check-data.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "country",
    "currency",
    "iso2",
    "iso3166",
    "iso4217",
    "currency-symbol",
    "minor-units",
    "iso3166-alpha3",
    "country-flag",
    "currency-format",
    "intl"
  ],
  "author": "Oleksii Didenko did.aleksej@gmail.com",
  "license": "ISC",
  "devDependencies": {
    "tsup": "8.3.5",
    "typescript": "5.6.3"
  }
}
